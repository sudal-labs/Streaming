# DB
DATABASE_URL=sqlite+aiosqlite:///./video_streaming.db

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=videos
MINIO_SECURE=false

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_TRANSCODE=video.transcode
KAFKA_GROUP_ID=video-worker

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_TTL_STATUS=10
REDIS_TTL_STREAM=3300
REDIS_TTL_LIST=30

# Upload
MAX_FILE_SIZE_MB=500
ALLOWED_EXTENSIONS=mp4,mov,avi,mkv